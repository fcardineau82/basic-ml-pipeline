# Virtual Environment
# This is your 'my_pandas_env' folder. Never upload this.
my_pandas_env/
env/
venv/
.env

# Python Caching
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebooks
.ipynb_checkpoints/

# IDE / Editor
.vscode/
.filetreeignore
.idea/
*.swp
*.swo
*~

# mypy / type checking
.mypy_cache/

# Distribution / Packaging
dist/
build/
*.egg-info/
*.egg

# Data Files
# We usually ignore data so the repo stays light.
# You'd use DVC if you want to version these.
data/
*.csv
*.xml

# Model Checkpoints
models/*.pkl
models/*.h5
models/*.onnx

# OS generated files
.DS_Store
Thumbs.db

# Keep specific tracked files
!models/metadata.json
!config.yaml